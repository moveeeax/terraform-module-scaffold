locals {
  tags = merge(
    {
      "Module"    = "{{ .Name }}"
      "ManagedBy" = "terraform"
    },
{{- if .HasTagsVar }}
    var.tags,
{{- end }}
  )
{{- if .HasNameVar }}

  name = var.name
{{- end }}
}

