.PHONY: fmt validate lint test integration-test docs

fmt:
	terraform fmt -recursive

validate:
	terraform init -backend=false >/dev/null && terraform validate

lint:
	tflint --init && tflint

# Native `terraform test` suite under tests/. Providers are mocked, so this
# needs no credentials and touches no cloud API. Requires Terraform >= 1.7.
test:
	terraform init -backend=false >/dev/null && terraform test

# Terratest suite under test/. This one provisions real infrastructure once you
# extend it past `terraform init` — do not wire it into a pull-request workflow.
# test/go.mod ships without a go.sum, so `go mod tidy` resolves it on first run.
integration-test:
	cd test && go mod tidy && go test -v -timeout 30m ./...

docs:
	terraform-docs markdown table --output-file README.md --output-mode inject .
